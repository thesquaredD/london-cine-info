{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@lci/core/*": ["../packages/core/src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/data/**/*.ts",
    "../packages/core/src/**/*.ts",
    "../vite.config.ts"
  ]
}
