{
  "name": "london-cine-info",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Every London cinema screening in one sortable table. A London take on paris-cine.info, powered by Clusterflick data.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-data": "tsx scripts/build-data.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "wrangler pages deploy dist --project-name london-cine-info"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8",
    "virtual-select-plugin": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
