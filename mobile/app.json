{
  "expo": {
    "name": "Readograph",
    "slug": "readograph",
    "scheme": "readograph",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171310",
    "ios": {
      "bundleIdentifier": "com.readograph.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.readograph.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Readograph uses your location to list the cinemas near you. It is not stored or sent anywhere."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/LeagueSpartan-Regular.ttf",
            "./assets/fonts/LeagueSpartan-Medium.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "./plugins/with-android-back.cjs"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
