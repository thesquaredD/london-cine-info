{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["react", "react-native"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["app", "src", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
